# Servidor
PORT=8000
HOST=0.0.0.0

# APIs Externas
API_NINJS_KEY=tu_clave_api_ninjas
UNSPLASH_ACCESS_KEY=tu_clave_unsplash

# Base de datos
# Desarrollo: postgresql://postgres:postgres@db:5432/postgres
# Produccion: usar DATABASE_URL de Render PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# CORS
# Desarrollo: http://127.0.0.1:3000,http://localhost
# Produccion: https://tudominio.onrender.com
ORIGEN_PERMITIDO=http://127.0.0.1:3000,http://localhost

# API Key para rutas protegidas (pruebas externas)
API_SECRET_KEY=tu_clave_secreta_aqui

# Entorno: development | production
ENVIRONMENT=development
